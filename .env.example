# Application
APP_NAME=MediaTracker
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
APP_PORT=3000
AUTH_SECRET=replace-with-at-least-32-random-bytes
ALLOW_REGISTRATION=true
TRUST_PROXY=false

# PostgreSQL (use URL-encoded values when they contain reserved URL characters)
POSTGRES_DB=mediatracker
POSTGRES_USER=mediatracker
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://mediatracker:replace-with-a-long-random-password@db:5432/mediatracker

# Catalog providers (server only)
TMDB_API_TOKEN=
TMDB_API_BASE_URL=https://api.themoviedb.org/3
ANILIST_ENABLED=false
# Set true only after obtaining any permission required by current AniList terms.
ANILIST_TERMS_ACCEPTED=false
ANILIST_API_URL=https://graphql.anilist.co
CATALOG_TEST_MODE=false

# Metadata/cache behavior
CATALOG_TIMEOUT_MS=6000
CATALOG_CACHE_TTL_SECONDS=900
METADATA_STALE_DAYS=30
